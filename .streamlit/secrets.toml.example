# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to GitHub

# Stitch API Configuration (Optional - for live bank transaction syncing)
[stitch]
client_id = "your_stitch_client_id_here"
client_secret = "your_stitch_client_secret_here"
redirect_uri = "your_redirect_uri_here"

# Twilio WhatsApp Configuration (Optional - for automated notifications)
[twilio]
account_sid = "your_twilio_account_sid_here"
auth_token = "your_twilio_auth_token_here"
whatsapp_from = "whatsapp:+14155238886"

# Note: The app works in demo mode without these configurations
# You can add them later when ready to enable these features